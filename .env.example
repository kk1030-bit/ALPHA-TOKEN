TELEGRAM_BOT_TOKEN=put_your_botfather_token_here
TZ=Asia/Taipei

# Optional. Restrict bot usage to specific Telegram chat IDs, comma-separated.
# Leave empty to allow any user who can message the bot.
ALLOWED_CHAT_IDS=

# Excel file containing optional symbols in the first column or a symbol/coin/token column.
TOKEN_EXCEL_PATH=

# Hourly by default.
REPORT_INTERVAL_SECONDS=3600
REPORT_TOP_N=20
REPORT_LOOKBACK_SECONDS=3600

# dynamic: CryptoBubbles market-cap rank >= WATCH_MIN_MARKET_RANK, intersected with Binance Futures USDT markets.
# excel: only TOKEN_EXCEL_PATH.
# both: dynamic plus Excel additions.
WATCH_MODE=dynamic
WATCH_MIN_MARKET_RANK=101
WATCHLIST_REFRESH_SECONDS=600
OI_SNAPSHOT_WORKERS=8

# OI spike alert: notify subscribers when OI value jumps within this window.
OI_SPIKE_WINDOW_SECONDS=180
OI_SPIKE_CHECK_SECONDS=30
OI_SPIKE_MIN_CHANGE_PCT=8
OI_SPIKE_MIN_VALUE_USD=500000
OI_SPIKE_MIN_CONTRACTS_PCT=3
OI_SPIKE_PRICE_CONFIRM_PCT=0.5
OI_SPIKE_COOLDOWN_SECONDS=900

# Active position monitor after /entry.
